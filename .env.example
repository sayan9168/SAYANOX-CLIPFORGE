# Web-server settings. Never use NEXT_PUBLIC_ for worker credentials.
WORKER_API_URL=http://127.0.0.1:8000
# Set the SAME long random value on the worker before hosting publicly.
WORKER_API_TOKEN=
WORKER_REQUEST_TIMEOUT_SECONDS=30

# Worker settings: copy this file to worker/.env or set these in its environment.
# An explicit CLIPFORGE_DATA path must be writable; otherwise startup fails clearly.
# CLIPFORGE_DATA=/absolute/path/to/clipforge-data
# CLIPFORGE_MAX_UPLOAD_MB=2048
# CLIPFORGE_MAX_VIDEO_SECONDS=7200
# CLIPFORGE_JOB_TTL_HOURS=24
# CLIPFORGE_MAX_STORAGE_GB=50
# CLIPFORGE_RATE_LIMIT=30
# CLIPFORGE_MAX_PENDING_JOBS=100
# CLIPFORGE_WORKER_CONCURRENCY=1
# CLIPFORGE_FFMPEG_THREADS=2
# CLIPFORGE_MAX_ATTEMPTS=3
# CLIPFORGE_ALLOW_YTDLP=false
# CLIPFORGE_WEBHOOK_URL=
# CLIPFORGE_TRANSLATE_URL=
# WHISPER_MODEL=tiny
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
